# Export these in your shell. The app does NOT automatically load .env files.
# RENATURA_DATA=/absolute/path/to/persistent-data
# RENATURA_TOKEN=set-a-long-random-token-if-exposing-to-a-trusted-network
# ALEXNET_WEIGHTS=/absolute/path/to/species-alexnet-state-dict.pt
# ALEXNET_LABELS=/absolute/path/to/species-labels.json
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=your-secret-key
